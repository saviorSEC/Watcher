<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Metrics Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Key Metrics"
                android:textSize="16sp"
                android:textColor="@color/accent"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3">

                <TextView
                    android:id="@+id/tv_detail_detection_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detection Rate: —"
                    android:textColor="@color/on_surface"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_detail_confidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Avg Confidence: —"
                    android:textColor="@color/on_surface"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_detail_grade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grade: —"
                    android:textColor="@color/status_gold"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_detail_evasion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Evasion Rate: —"
                    android:textColor="@color/on_surface"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_detail_persona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Persona: —"
                    android:textColor="@color/on_surface"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tv_detail_pattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pattern: —"
                    android:textColor="@color/on_surface"
                    android:padding="8dp" />

            </GridLayout>
        </LinearLayout>

        <!-- Trials Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_dark"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trials"
                android:textSize="16sp"
                android:textColor="@color/accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_detail_trials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— trials (chart goes here)"
                android:textColor="@color/on_surface" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
